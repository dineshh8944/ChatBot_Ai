# Backup AI (used only when Puter has no credit / fails). Leave any key empty to skip it.
# Free keys:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
# OpenAI (paid, needs billing credit): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# History storage. Empty = keep history in server memory.
# If MongoDB is not running, the backend switches to memory by itself.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=chatbot_db
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
